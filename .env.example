# Telegram
TELEGRAM_TOKEN=           # From @BotFather
ALLOWED_CHAT_ID=          # Your personal chat ID

# Email digest
GMAIL_USER=               # Gmail address used to send digests
GMAIL_APP_PASSWORD=       # Gmail app-specific password (Settings → Security → App passwords)
EMAIL_RECIPIENTS=         # Comma-separated list: you@gmail.com, friend@gmail.com

# JSearch / RapidAPI (optional — LinkedIn-only if omitted)
JSEARCH_API_KEY=          # RapidAPI key for JSearch (200 req/month free tier)
